# ──────────────────────────────────────────────────────────────────────────────
# WAX Wallet Viewer — Environment Variables
# Copy this to .env.local for local development.
# Set these in Railway → your service → Variables for production.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED: Password for the /admin panel. Set something strong.
ADMIN_PASSWORD=changeme_please

# OPTIONAL: Comma-separated list of AtomicAssets API base URLs (priority order).
# The app tries the first; on failure falls back to the next.
# Defaults are used if this is unset.
ATOMICASSETS_ENDPOINTS=https://wax.api.atomicassets.io,https://aa.wax.blacklusion.io,https://wax-aa.eu.eosamsterdam.net,https://atomic.wax.eosrio.io

# OPTIONAL: Featured collections shown as quick-filter chips on the homepage.
# FEATURED_COLLECTIONS=atomicairdrops,thecryptofive

# OPTIONAL: Collections hidden from the UI (spam suppression).
# BLOCKED_COLLECTIONS=spamcollect1,spamcollect2

# ── DO NOT SET NODE_ENV HERE ───────────────────────────────────────────────────
# Railway sets NODE_ENV=production automatically during build and runtime.
# Setting it manually causes a Next.js "non-standard NODE_ENV" warning.
# Remove NODE_ENV from Railway Variables if you added it.
