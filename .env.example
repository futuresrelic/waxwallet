# ──────────────────────────────────────────────────────────
# WAX Wallet Viewer — Environment Variables
# Copy this file to .env.local for local development
# Set these in Railway for production
# ──────────────────────────────────────────────────────────

# Admin panel password (change this to something strong!)
ADMIN_PASSWORD=changeme_please

# Comma-separated list of AtomicAssets API base URLs (in priority order)
# The app tries the first one; on failure it falls back to the next.
ATOMICASSETS_ENDPOINTS=https://wax.api.atomicassets.io,https://aa.wax.blacklusion.io,https://wax-aa.eu.eosamsterdam.net,https://atomic.wax.eosrio.io

# Optional: Featured collections shown as quick-filter chips on the homepage
# FEATURED_COLLECTIONS=atomicairdrops,thecryptofive

# Optional: Collections hidden from the UI (spam suppression)
# BLOCKED_COLLECTIONS=spamcollect1,spamcollect2

# Node environment (set automatically by Railway)
NODE_ENV=production
